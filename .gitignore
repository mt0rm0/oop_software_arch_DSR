# ── Python ────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
dist/
build/

# ── uv / virtual environments ─────────────────────────────────────────────
.venv/
# uv.lock is intentionally committed — it pins exact versions for reproducibility

# ── Data — track with DVC instead of git ──────────────────────────────────
data/raw/
data/interim/
data/processed/
*.csv
*.parquet
*.feather
*.arrow
# Exceptions: small reference files
!data/sample_*.csv
!data/description.json

# ── Models — large binary artefacts ───────────────────────────────────────
models/
*.pkl
*.joblib
*.pt
*.pth
*.h5
*.onnx

# ── Jupyter ───────────────────────────────────────────────────────────────
.ipynb_checkpoints/
*/.ipynb_checkpoints/

# ── VS Code — commit settings.json and extensions.json, ignore personal state
.vscode/*.log
.vscode/launch.json
.vscode/.ropeproject

# ── Secrets ───────────────────────────────────────────────────────────────
.env
.env.*
!.env.example
*.key
secrets.yaml
credentials.json

# ── OS ────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── MLflow / DVC artefacts ─────────────────────────────────────────────────
mlruns/
.dvc/tmp/
